# LM Studio — servidor local compatível com a API da OpenAI
# (LM Studio > aba Developer > Start Server)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
MODEL=qwen/qwen3.5-9b

# "Hoje" do agente. O dataset fornecido é um snapshot: os pedidos vão só até 2026-03-22.
# Ancoramos o presente logo após para as políticas de prazo (troca, entrega) fazerem sentido.
DATA_REFERENCE_DATE=2026-03-25

# Teto do histórico enviado ao modelo a cada turno (o histórico completo continua salvo).
# Baixe se a janela de contexto do modelo carregado for menor que 16k.
MAX_HISTORY_TOKENS=8000

# LOG_LEVEL=DEBUG para ver cada chamada de ferramenta e o tempo de cada turno.
LOG_LEVEL=INFO
